# ==============================================================================
# Expiry Rescue AI - Server-Side Environment Configuration
# ==============================================================================
#
# IMPORTANT:
# - API keys must be kept in this server-side configuration file (.env).
# - NEVER prefix keys with VITE_ to prevent leaking them to the browser client.
# - If no API key is provided, the application runs 100% reliably using the
#   embedded Deterministic Tool Engine without hallucinating numbers.

# --- Option 1: Google Gemini (Recommended) ---
# Get a free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Gemini model override (defaults to gemini-1.5-flash)
# Supported: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# --- Option 2: OpenAI (Alternative) ---
# Get an OpenAI API key at: https://platform.openai.com/
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
